{
  "name": "@proagents/plugin-lifecycle-web",
  "version": "0.5.0",
  "description": "Web development lifecycle definition plugin for ProAgents Workspace — contributes the web-development lifecycle (understand → plan → implement → unit/browser test → review → ship) as pure data.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@proagents/workspace": "workspace:*"
  },
  "devDependencies": {
    "@proagents/contracts": "workspace:*",
    "typescript": "^5.6.0"
  }
}
